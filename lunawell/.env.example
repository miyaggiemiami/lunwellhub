# Copy this file to .env and fill in real values before deploying.

# Endpoint the Book page's consultation form submits to.
# Leave blank to fall back to a "mailto:" link instead of a network request.
# Works out of the box with a Formspree endpoint (https://formspree.io),
# a Netlify/Vercel serverless function, or your own booking API —
# as long as it accepts a POST with multipart/form-data and returns 2xx JSON.
VITE_FORM_ENDPOINT=

# Clinic contact emails shown in the footer and booking page.
VITE_CLINIC_EMAIL=info@lunawellhub.co.za
VITE_DOCTOR_EMAIL=drntsiki@lunawellhub.co.za

# WhatsApp number (international format, no "+" or spaces) used for the
# "Chat on WhatsApp" links.
VITE_WHATSAPP_NUMBER=27817853273
